# MaSoVa Agent Environment Configuration Template
# Copy to .env (never commit real secrets)

# --- LLM (Google ADK / Gemini) ---
# Prefer LLM_* names; GOOGLE_API_KEY still works as fallback
LLM_API_KEY=your_api_key_here
# Stage 1 requires Gemini 3.5 or newer.
LLM_MODEL=gemini-3.5-flash
# Cheaper/faster model for ops agents 2–8 (optional; falls back to LLM_MODEL)
OPS_LLM_MODEL=gemini-3.5-flash
# Optional Gemma second pass for Model Armor-lite chat input screening.
# Regex heuristics always run; when set, Gemma classifies ambiguous input
# only if regex did not already decide. Leave unset in CI / deterministic tests.
# GEMMA_MODEL=gemma-3-12b-it
# true|false — default: try LLM when a key is present
OPS_PREFER_LLM=
GOOGLE_API_KEY=your_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=0

# Ops tool-loop budgets
OPS_MAX_TOOL_CALLS=12
OPS_LLM_TIMEOUT_SEC=45
OPS_CONTEXT_CHARS=8000

# --- Customer chat JWT (must match MaSoVa core-service HS512) ---
JWT_SECRET=change-me-same-as-backend-hs512-secret

# --- Inbound ops triggers (scheduler / internal) ---
# Header: X-Agent-Api-Key
AGENT_TRIGGER_API_KEY=change-me-service-to-service-key

# Per-agent scoped API credentials (JSON array). Replaces the single shared
# AGENT_TRIGGER_API_KEY above with least-privilege keys. When unset, AGENT_TRIGGER_API_KEY
# becomes one master ("*"-scoped) credential (migration/back-compat path).
# Example:
# AGENT_API_KEYS=[{"key":"sched-...","scopes":["*"]},{"key":"inv-...","scopes":["trigger:inventory_reorder","read:registry"]}]
AGENT_API_KEYS=

# --- Outbound to MaSoVa platform backend ---
# Lab LAN example: http://192.168.50.88:8080 — never baked into source defaults.
BACKEND_URL=http://127.0.0.1:8080
AGENT_TOKEN=change-me-backend-service-token

# --- Sessions / events ---
# Chat sessions: Redis DB 1 (falls back to in-memory if unreachable)
REDIS_URL=redis://127.0.0.1:6379/1
# Optional separate DB for idempotency keys
REDIS_HOST=
REDIS_PORT=6379
REDIS_IDEMPOTENCY_DB=2
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# --- Proposals (local durable JSONL) ---
# Default: <repo>/data/proposals (gitignored)
PROPOSAL_DATA_DIR=

# --- HTTP / process ---
RATE_LIMIT_PER_MIN=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
LOG_LEVEL=INFO
LOG_FILE=

# --- Demo Mode (Hackathon 24-store Paris fleet simulation) ---
DEMO_MODE=true
DEMO_DB_PATH=data/demo/masova_demo.sqlite
DEMO_FOCUS_STORE_ID=68a1f2c9e4b0a1234567890a
# Scheduler timezone (Paris demo default). Indian ops: Asia/Kolkata.
SCHEDULER_TZ=Europe/Paris


